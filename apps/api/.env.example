# ── Manhar Nexus API environment ─────────────────────────────────────────────
# Single source of truth for every variable the API (apps/api/src/config/
# configuration.ts), the seed (prisma/seed.ts) and the demo seed read.
#
# Development: copy to apps/api/.env  — every value below works as-is with the
#              portable dev cluster (npm run db:init). All keys are optional in
#              development; the schema supplies the same defaults.
# Production : copy to deploy/api.env (gitignored) and replace EVERY value
#              marked [PROD]. The API refuses to boot in NODE_ENV=production
#              when a development default survives (see validateEnv()).
#
# NEVER commit a real .env / api.env. Generate secrets with e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ── Runtime ──────────────────────────────────────────────────────────────────
# [PROD] production. One of: development | test | production
NODE_ENV=development
# Port the HTTP server binds to (container listens on 3000).
PORT=3000
# fatal | error | warn | info | debug | trace   (production: info or warn)
LOG_LEVEL=info
# [PROD] Exact public HTTPS origin of the web app, no path, no trailing slash.
# Production refuses localhost/loopback and plain http. Same-origin deploys
# (Caddy serving web + /api) still set this to the public origin.
CORS_ORIGIN=http://localhost:5173
# Proxy hops to trust for the real client IP (rate limits, login telemetry).
# [PROD] 1 when exactly one reverse proxy (Caddy) sits in front of the API.
TRUST_PROXY=0

# ── Database ─────────────────────────────────────────────────────────────────
# [PROD] Required. Production refuses the dev default below.
# Docker compose: host is the service name, e.g. @postgres:5432
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F).
DATABASE_URL=postgresql://nexus:nexus@localhost:15432/nexus?schema=public
# Direct (non-pooled) connection used by Prisma migrations/seeds. On a single
# Postgres host this is the same as DATABASE_URL; on Neon it is the direct URL
# (not the -pooler host). Required by prisma/schema.prisma directUrl.
DATABASE_URL_UNPOOLED=postgresql://nexus:nexus@localhost:15432/nexus?schema=public

# ── Optional dependencies (reported by /health) ──────────────────────────────
REDIS_URL=redis://localhost:16379
# "true" makes Redis a required health component (503 when down). Default false.
REDIS_REQUIRED=false
STORAGE_HEALTH_URL=http://localhost:19000/minio/health/live
# "true" makes object storage a required health component. Default false.
STORAGE_REQUIRED=false
# "false" omits the optional Redis/Storage probes from /health entirely, so a
# serverless host without them reports "ok" rather than "degraded". Default true.
# HEALTH_INCLUDE_OPTIONAL=false

# ── Authentication (ADR-004/022/023/028) ─────────────────────────────────────
# [PROD] HS256 signing secret. >=32 chars always, >=64 chars in production,
# and never the dev placeholder below.
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-in-production-0001
JWT_ACCESS_TTL_SECONDS=300
REFRESH_TTL_DAYS=30
REFRESH_ABSOLUTE_TTL_DAYS=90
# Browser-visible path of the refresh cookie. Keep /auth for direct-origin
# deployments; use /api/auth when the API is proxied under /api (Caddy, Vercel).
# Must start with / and must not end with / (except "/").
# REFRESH_COOKIE_PATH=/api/auth
# argon2id cost (OWASP floor) — raise over time as hardware allows.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Per-account login lockout.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Coarse per-IP rate limit on /auth/* (in-memory, per API instance).
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000

# ── Public registration requests (landing page, ADR-033) ─────────────────────
# [PROD] HMAC key for the stored visitor-IP hash (the raw IP is never stored).
# Optional in development: when unset a fixed dev key is used, so hashes are
# reproducible but NOT secret. Production refuses the dev key and anything
# shorter than 32 chars. Changing it only breaks the "5 per IP per hour" window
# for requests already stored; it never invalidates data.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REGISTRATION_IP_SALT=dev-only-registration-ip-salt-change-in-production
# Per-IP POST limit on /public/registrations per window (in-memory, per API
# instance; the database also caps 5 per IP per hour and 3 per email per day).
# Needs TRUST_PROXY=1 behind Caddy, otherwise every visitor shares the proxy IP.
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_TTL_MS=3600000

# ── QR digital menu (guest menu, ADR-035) ────────────────────────────────────
# [PROD] Directory for uploaded menu pictures (logo, cover, dishes). In production
# there is NO default: unset = uploads answer 503 (so photos never land in a
# container layer). compose mounts the "media" volume here. Development default:
# ./var/media.
# MEDIA_DIR=/data/media
# Largest accepted picture upload in bytes (default 6291456 = 6 MiB).
# MEDIA_MAX_UPLOAD_BYTES=6291456
# Absolute base for picture URLs in the PUBLIC menu, no trailing slash. Normally
# unset: derived from the request (Host + X-Forwarded-Prefix "/api" from Caddy
# when TRUST_PROXY>0).
# MEDIA_PUBLIC_BASE_URL=https://app.example.com/api
# Web origin used to print the table QR URLs (https://app.example.com/m/<token>).
# Unset = the staff app builds it from its own origin.
# QR_PUBLIC_BASE_URL=https://app.example.com
# Per-minute limits of the public endpoints (in-memory, per API instance); the
# defaults suit a busy dining room behind one Wi-Fi IP. Names: MENU_IP, MENU_TOKEN,
# BAD_TOKEN_IP, GUEST_CREATE_IP, GUEST_CREATE_TOKEN, STATE_GUEST, STATE_IP,
# ORDER_GUEST, ORDER_TOKEN, ORDER_IP, WAITER_GUEST, WAITER_TOKEN, WAITER_IP,
# PAY_GUEST, PAY_IP, STREAM_OPEN_IP, STREAM_CONCURRENT_IP, STREAM_CONCURRENT_TOKEN,
# MEDIA_IP.
# GUESTMENU_LIMIT_ORDER_GUEST=4
# Other knobs: GUESTMENU_MAX_GUESTS_PER_SESSION (40), GUESTMENU_GUEST_TOKEN_TTL_HOURS (12),
# GUESTMENU_STREAM_MAX_SECONDS (1800), GUESTMENU_MENU_CACHE_MS (2000).

# ── First platform admin (created once by `prisma db seed`, ADR-022) ─────────
# [PROD] Both required. Production refuses these dev defaults and passwords
# shorter than 16 chars. The seed never resets an existing user's password;
# rotate it in the app after first login.
PLATFORM_BOOTSTRAP_EMAIL=platform@manhar.local
PLATFORM_BOOTSTRAP_PASSWORD=ChangeMe!Dev12345

# ── Demo seed guard (prisma/demo-seed.ts) ────────────────────────────────────
# Must be "true" for `npm run demo:seed` to run. NEVER set in production; the
# demo seed also refuses NODE_ENV=production.
# NEXUS_DEMO_SEED=true
