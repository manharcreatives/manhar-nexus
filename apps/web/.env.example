# ── Manhar Nexus web app (Vite) ──────────────────────────────────────────────
# These are BUILD-TIME variables: Vite inlines them into the JS bundle, so they
# are public. Never put a secret here.
#
# Development: copy to apps/web/.env.local (gitignored) only if you need to
#              override the defaults.
# Production : passed as Docker build args (see Dockerfile.web and
#              docker-compose.prod.yml); changing them requires a rebuild.

# Base URL the browser uses to reach the API.
#   Default (dev, unset)  : http://localhost:3000  (cross-origin, CORS)
#   Production (Caddy)    : /api   — same origin; Caddy strips the /api prefix.
#   Vercel (same origin)  : /api   — the serverless handler strips it.
VITE_API_URL=http://localhost:3000

# Realtime transport. "sse" (default) for the Docker/Caddy deployment;
# "poll" on serverless hosts where each request may hit a different instance.
# VITE_REALTIME_MODE=sse

# White-label (docs/ui/OWNERSHIP_AND_WHITE_LABEL.md). Optional.
# VITE_BRAND_NAME=Manhar Nexus
# VITE_BRAND_ACCENT=#22c55e
# VITE_BRAND_FOOTNOTE=   (empty hides the login footnote)
