# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# Manhar Nexus web image: Vite static build served by Caddy, which is also the
# public edge (TLS, security headers, SPA fallback, /api/* → API).
#
#   docker build -f Dockerfile.web -t nexus-web:<tag> \
#     --build-arg VITE_API_URL=/api \
#     --build-arg VITE_BRAND_NAME="Manhar Nexus" .
#
# VITE_* values are inlined into the bundle at build time (public, never
# secrets); changing them requires a rebuild. Runtime config (domain, ACME
# email, API upstream) is read by the Caddyfile from the environment.
# ─────────────────────────────────────────────────────────────────────────────
ARG NODE_VERSION=22
ARG CADDY_VERSION=2.10

FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /app
ENV NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/tsconfig.json packages/shared/
COPY packages/shared/src packages/shared/src
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
# --ignore-scripts skips the root postinstall (Prisma generate is API-only);
# native build tools (esbuild, rollup, lightningcss, tailwind oxide) ship as
# platform optional dependencies and need no install script.
RUN npm ci --ignore-scripts && npm run build -w @nexus/shared
COPY apps/web apps/web
ARG VITE_API_URL=/api
ARG VITE_BRAND_NAME
ARG VITE_BRAND_ACCENT
# Build args are visible to RUN as env vars and Vite reads VITE_* from the
# process env. Empty optional args are unset so the app falls back to its
# defaults instead of an empty brand name.
RUN [ -n "$VITE_BRAND_NAME" ] || unset VITE_BRAND_NAME; \
    [ -n "$VITE_BRAND_ACCENT" ] || unset VITE_BRAND_ACCENT; \
    npm run build -w @nexus/web

FROM caddy:${CADDY_VERSION}-alpine AS runtime
# Run as an unprivileged user; the binary keeps CAP_NET_BIND_SERVICE so it can
# still bind :80/:443.
RUN apk add --no-cache libcap \
 && setcap cap_net_bind_service=+ep /usr/bin/caddy \
 && (getent group caddy >/dev/null || addgroup -S caddy) \
 && (id -u caddy >/dev/null 2>&1 || adduser -S -D -H -G caddy caddy) \
 && mkdir -p /data /config \
 && chown -R caddy:caddy /data /config
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
USER caddy
EXPOSE 80 443 443/udp
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8081/healthz"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
