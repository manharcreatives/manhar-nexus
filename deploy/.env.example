# ── docker-compose.prod.yml settings ─────────────────────────────────────────
# Copy to deploy/.env (gitignored) and pass with:
#   docker compose -f docker-compose.prod.yml --env-file deploy/.env <cmd>
# Also loaded as env_file by the postgres service. API secrets do NOT go here;
# they go in deploy/api.env (template: apps/api/.env.example).

# Image naming. Every deploy uses an immutable tag (git short SHA or semver);
# rollback = set the previous tag and `up -d` again. Never use "latest".
NEXUS_REGISTRY=nexus
IMAGE_TAG=replace-with-git-sha

# Public hostname served by Caddy (DNS A/AAAA → this host; ports 80+443 open).
NEXUS_DOMAIN=app.example.com
# ACME contact for certificate expiry notices.
ACME_EMAIL=ops@example.com
# acme = public certificates (production). internal = Caddy's local CA, for
# CI or a staging host without public DNS (clients must trust its root.crt).
NEXUS_TLS=acme

# Optional white-label build args (public, inlined into the web bundle).
VITE_BRAND_NAME=
VITE_BRAND_ACCENT=

# Postgres container bootstrap (used only when the data volume is first
# created). DATABASE_URL in deploy/api.env must use the same user/password/db
# with host "postgres", e.g.
#   DATABASE_URL=postgresql://nexus_app:<password>@postgres:5432/nexus?schema=public
POSTGRES_USER=nexus_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=nexus
