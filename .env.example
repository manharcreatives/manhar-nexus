# ── Manhar Nexus API environment ─────────────────────────────
# Copy to .env and adjust. NEVER commit real .env files or secrets.
# Canonical dev ports deliberately avoid common system services:
#   PostgreSQL → 15432 · Redis → 16379 · MinIO → 19000

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://nexus:nexus@localhost:15432/nexus?schema=public
REDIS_URL=redis://localhost:16379
# Optional until realtime consumers exist (Phase 8)
REDIS_REQUIRED=false

# ── Authentication (Phase 3 — ADR-004/022/023) ──
# JWT access-token signing secret (HS256). MUST be >=32 chars and overridden
# per environment; production refuses to boot on the dev placeholder.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=300
REFRESH_TTL_DAYS=30
REFRESH_ABSOLUTE_TTL_DAYS=90
# argon2id (OWASP floor) — raise over time as hardware allows.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Per-account login lockout.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# First platform admin, provisioned idempotently by the seed (ADR-022).
# Replaces the retired shared-token internal-admin bridge (ADR-020).
PLATFORM_BOOTSTRAP_EMAIL=platform@manhar.local
PLATFORM_BOOTSTRAP_PASSWORD=change-me-strong-bootstrap-password
